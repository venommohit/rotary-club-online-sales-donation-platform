# Copy to .env for local development (.env is git-ignored). On Render set these in the dashboard.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=any-long-random-string
FIREBASE_PROJECT_ID=your-firebase-project-id
# Local: leave unset and keep firebase-service-account.json next to manage.py.
# Server: paste the ENTIRE service-account JSON here.
# FIREBASE_CREDENTIALS_JSON=
STRIPE_SECRET_KEY=sk_test_...
# Local: value printed by `stripe listen`. Server: signing secret of the webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...
STAFF_USERNAME=committee
STAFF_PASSWORD=choose-a-strong-password
# Email: Gmail locally ...
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=gmail-app-password
# ... or Brevo on the server (Render blocks SMTP)
# BREVO_API_KEY=xkeysib-...
# EMAIL_FROM_ADDRESS=verified-sender@example.com
